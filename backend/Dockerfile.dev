# Dev image with hot reload (air) + templ generation.
FROM golang:1.26-alpine

RUN apk add --no-cache curl \
    && go install github.com/air-verse/air@latest \
    && go install github.com/a-h/templ/cmd/templ@latest

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080
CMD ["air", "-c", ".air.toml"]
